extends layout

block contenido
  h2 Choferes

  h3 Nuevo chofer
  form(action="/choferes", method="POST")
    label(for="nombre") Nombre
    input#nombre(type="text", name="nombre", required)
    label(for="apellido") Apellido
    input#apellido(type="text", name="apellido", required)
    button(type="submit") Guardar

  h3 Listado
  if choferes.length
    table
      thead
        tr
          th Nombre
          th Apellido
          th Acciones
      tbody
        each chofer in choferes
          tr
            td= chofer.nombre
            td= chofer.apellido
            td
              a(href=`/choferes/${chofer._id}/editar`) Modificar
              form.inline(action=`/choferes/${chofer._id}/eliminar`, method="POST")
                button(type="submit") Eliminar
  else
    p No hay choferes cargados.
