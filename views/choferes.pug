extends layout

block contenido
  h2 Modulo de Choferes

  section.formulario-seccion
    h3 Registrar Chofer
    form(action="/choferes" method="POST")
      div
        label(for="nombre") Nombre:
        input#nombre(type="text" name="nombre" required)
      div
        label(for="apellido") Apellido:
        input#apellido(type="text" name="apellido" required)
      button(type="submit") Guardar Chofer

  section.listado-seccion
    h3 Listado de Choferes
    if choferes && choferes.length
      table
        thead
          tr
            th ID
            th Nombre
            th Apellido
            th Acciones
        tbody
          each chofer in choferes
            tr
              td= chofer.id
              td= chofer.nombre
              td= chofer.apellido
              td
                a(href=`/choferes/${chofer.id}`)
                  button(type="button") Ver mas
    else
      p No hay choferes registrados actualmente.
