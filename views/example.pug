extends layout

block contenido
  h2 Modulo de Ejemplo: Personas

  section.formulario-seccion
    h3 Registrar Persona
    form(action="/personas" method="POST")
      div
        label(for="nombre") Nombre:
        input#nombre(type="text" name="nombre" required)
      div
        label(for="apellido") Apellido:
        input#apellido(type="text" name="apellido" required)
      button(type="submit") Guardar

  section.listado-seccion
    h3 Lista de Personas
    if personas && personas.length
      table
        thead
          tr
            th ID
            th Nombre
            th Apellido
        tbody
          each persona in personas
            tr
              td= persona.id
              td= persona.nombre
              td= persona.apellido
    else
      p No hay personas registradas actualmente.
