doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    title Modulo Rutas
  body
    nav
      a(href="/choferes") Choferes
      |  | 
      a(href="/entregas") Entregas
      |  | 
      a(href="/incidencias") Incidencias
      |  | 
      a(href="/rutas") Rutas
      |  | 
      a(href="/vehiculos") Vehiculos
    hr

    h2 Modulo de Rutas

    h3 Registrar Ruta
    form(action="/rutas" method="POST")
      label(for="choferId") ID del chofer:
      input#choferId(type="number" name="choferId" min="1" required)
      br
      br
      label(for="vehiculoId") ID del vehiculo:
      input#vehiculoId(type="number" name="vehiculoId" min="1" required)
      br
      br
      label(for="fecha") Fecha:
      input#fecha(type="date" name="fecha" required)
      br
      br
      label(for="horaInicio") Hora de inicio:
      input#horaInicio(type="time" name="horaInicio" required)
      br
      br
      label(for="horaFinEstimada") Hora de fin estimada:
      input#horaFinEstimada(type="time" name="horaFinEstimada" required)
      br
      br
      button(type="submit") Guardar Ruta

    h3 Listado de Rutas
    if rutas && rutas.length
      table(border="1")
        thead
          tr
            th ID
            th Chofer ID
            th Vehiculo ID
            th Fecha
            th Hora de Inicio
            th Hora de Fin Estimada
            th Estado
            th Acciones
        tbody
          each ruta in rutas
            tr
              td= ruta.id
              td= ruta.choferId
              td= ruta.vehiculoId
              td= ruta.fecha
              td= ruta.horaInicio
              td= ruta.horaFinEstimada
              td= ruta.estado
              td
                a(href=`/rutas/${ruta.id}`) Ver mas
    else
      p No hay rutas registradas actualmente.