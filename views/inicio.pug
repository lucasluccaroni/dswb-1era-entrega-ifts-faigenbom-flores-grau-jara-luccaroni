//- lucas: vista inicio con condicional auth
extends layout

block contenido
  if usuario
    h2 Bienvenido, #{usuario.nombre}
    p Elegí un módulo para empezar a operar:
    ul
      li: a(href="/choferes") Choferes
      li: a(href="/vehiculos") Vehículos
      li: a(href="/rutas") Rutas
      li: a(href="/entregas") Entregas
      li: a(href="/incidencias") Incidencias
      if usuario.rol === "admin"
        li: a(href="/usuarios") Usuarios
  else
    h2 Sistema de gestión logística
    p Para operar con los módulos del sistema, por favor inicia sesión.
    div.acciones-auth
      a.btn(href="/login") Iniciar sesión
    br
    p La API JSON está disponible en <code>/api</code>.
