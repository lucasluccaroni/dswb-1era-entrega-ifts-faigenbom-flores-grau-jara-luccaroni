PORT=3000
NODE_ENV=development
MONGO_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/freshroute?retryWrites=true&w=majority

# Ficha 3 (JWT): secreto largo y aleatorio. Cada uno puede usar uno distinto en su .env
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1h

# Administrador inicial. Al arrancar la app, si NO existe ningun admin, se crea con estos datos
# (asi el sistema desplegado se gestiona sin ejecutar comandos). Tambien los usa npm run crear-admin
ADMIN_EMAIL=admin@freshroute.test
ADMIN_PASSWORD=cambiar_esta_clave
ADMIN_NOMBRE=Administrador

# Registro publico de usuarios (/registro y POST /api/usuarios/registro).
# En desarrollo true, para crear usuarios de prueba. En produccion NO definirla (o false):
# los usuarios los crea el admin desde la pantalla /usuarios.
REGISTRO_PUBLICO=true

# SOLO DESARROLLO: simula un usuario logueado mientras las costuras 2 y 3 son placeholders.
# Valores: admin u operador. Dejalo comentado en el servidor real y BORRALO del codigo al integrar.
# DEV_FAKE_ROL=admin
